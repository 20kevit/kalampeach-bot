# KalamPeach Telegram Operations Bot — configuration template.
#
# Copy these keys into the private environment configured in cPanel (or into a
# private .env file outside public_html, readable only by the account user).
# Never commit real values. Never place this file under public_html.
#
# Every value below is REQUIRED unless marked optional. Startup validates them
# and fails with a clear, secret-safe message when one is missing or still a
# placeholder. Run `python scripts/doctor.py` to check a configuration.

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Bot token from BotFather. Secret.
TELEGRAM_BOT_TOKEN=
# Numeric chat ID of the ONE configured staff group (negative, e.g. -1001234567890).
TELEGRAM_GROUP_ID=
# Numeric Telegram user ID of the manager (daily + on-demand reports).
MANAGER_TELEGRAM_ID=
# Comma-separated numeric Telegram user IDs allowed to record events.
# Include MANAGER_TELEGRAM_ID here only if the manager may also record events.
EMPLOYEE_TELEGRAM_IDS=
# Random high-entropy secret used to validate Telegram webhook requests.
# Telegram accepts 1-256 characters from A-Z, a-z, 0-9, "_" and "-".
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS URL of the webhook, including the /telegram/webhook path.
# Example: https://example.com/telegram/webhook
WEBHOOK_PUBLIC_URL=
# Optional; official Telegram Bot API base URL. Change only for a sanctioned
# test double.
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# ---------------------------------------------------------------------------
# NVIDIA AI provider (replaceable adapter)
# ---------------------------------------------------------------------------
# Secret API key. Never log or commit it.
NVIDIA_API_KEY=
# Verified base URL for the selected NVIDIA service, e.g. the OpenAI-compatible
# chat-completions base. The owner must confirm this value; the code does not
# assume or hardcode an endpoint.
NVIDIA_BASE_URL=
# Exact model identifier available to the owner's NVIDIA account. The owner must
# supply and verify it; the code does not choose a model.
NVIDIA_MODEL=
# Optional tuning (defaults shown). Keep the timeout small enough that one cron
# run stays inside shared-hosting limits.
# NVIDIA_TIMEOUT_SECONDS=15
# NVIDIA_MAX_RETRIES=1
# NVIDIA_RESPONSE_FORMAT=json_object

# ---------------------------------------------------------------------------
# Business configuration
# ---------------------------------------------------------------------------
# Fixed for the MVP (Asia/Tehran, 23:30). Validation rejects other values.
BUSINESS_TIMEZONE=Asia/Tehran
DAILY_REPORT_TIME=23:30
# Leave EMPTY until the owner explicitly chooses a default currency. When empty,
# a financial event without an explicit currency becomes a pending
# clarification instead of being silently assigned a currency.
DEFAULT_CURRENCY=

# ---------------------------------------------------------------------------
# Persistence — absolute path outside public_html (default SQLite)
# ---------------------------------------------------------------------------
# The directory is created with 0700 permissions if missing. The owner must
# replace CPANEL_USER with the real account name.
DATABASE_PATH=/home/CPANEL_USER/data/kalampeach_bot.sqlite3
# Optional SQLite tuning (defaults shown). Use DELETE only if the host
# filesystem cannot support WAL safely.
# SQLITE_BUSY_TIMEOUT_MS=5000
# SQLITE_JOURNAL_MODE=WAL

# ---------------------------------------------------------------------------
# Runtime / cron worker
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Optional private .env file to load when environment variables are absent.
# ENV_FILE=/home/CPANEL_USER/kalampeach/.env
# Worker limits keep one cron run short and bounded.
# WORKER_BATCH_SIZE=20
# WORKER_MAX_SECONDS=50
# WORKER_LEASE_SECONDS=120
# WORKER_MAX_ATTEMPTS=5
# DAILY_REPORT_RECOVERY_HOURS=6
# REPORT_MAX_RANGE_DAYS=62
# MAX_WEBHOOK_BYTES=262144
