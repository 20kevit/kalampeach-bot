# KalamPeach Telegram Operations Bot — configuration template.
#
# Copy the keys you need into the PRIVATE environment of the cPanel Python
# application (or into a private env file outside public_html, see
# CPANEL-DEPLOYMENT.md). Never commit real values and never place this file
# under public_html.
#
# Keys marked REQUIRED must be supplied by the owner before the application
# can start. Placeholders below are intentionally empty: no credential,
# endpoint, model ID, Telegram ID or currency is invented by this repository.

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# REQUIRED. Token from BotFather. Secret.
TELEGRAM_BOT_TOKEN=

# REQUIRED. Numeric ID of the ONE configured staff group (usually negative).
TELEGRAM_GROUP_ID=

# REQUIRED. Numeric Telegram user ID of the single manager.
MANAGER_TELEGRAM_ID=

# Comma-separated numeric Telegram user IDs allowed to record events.
# The manager can also record when listed here or when
# MANAGER_CAN_RECORD_EVENTS=true.
EMPLOYEE_TELEGRAM_IDS=

# REQUIRED. Random high-entropy secret (16-256 chars, A-Z a-z 0-9 _ -).
# Telegram echoes it in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=

# REQUIRED. Public HTTPS URL of the webhook route, e.g.
# https://example.com/telegram/webhook
WEBHOOK_PUBLIC_URL=

# Optional. Telegram Bot API base URL (override only for testing).
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Allow the manager to record events even when not in EMPLOYEE_TELEGRAM_IDS.
MANAGER_CAN_RECORD_EVENTS=false

# Post a short confirmation reply in the group after a confirmed event.
SEND_GROUP_ACKNOWLEDGEMENTS=true

# ---------------------------------------------------------------------------
# NVIDIA (AI provider)
# ---------------------------------------------------------------------------
# REQUIRED. Secret API key.
NVIDIA_API_KEY=

# REQUIRED. Base URL of the OpenAI-compatible chat-completions API.
# The adapter appends "/chat/completions" unless the URL already ends with it.
# Owner must verify the exact endpoint for the selected NVIDIA service.
NVIDIA_BASE_URL=

# REQUIRED. Exact model identifier available to the account. Not chosen here.
NVIDIA_MODEL=

# Optional tuning.
NVIDIA_TIMEOUT_SECONDS=30
NVIDIA_MAX_RETRIES=2
NVIDIA_TEMPERATURE=0
# Send response_format={"type":"json_object"}. Enable only if the selected
# model/service is verified to support it.
NVIDIA_JSON_MODE=false

# ---------------------------------------------------------------------------
# Business configuration
# ---------------------------------------------------------------------------
# Fixed by the product specification.
BUSINESS_TIMEZONE=Asia/Tehran
DAILY_REPORT_TIME=23:30

# Currency applied ONLY when a message omits it. Leave empty until the owner
# explicitly chooses a default; empty means "ask the employee / exclude from
# monetary totals".
DEFAULT_CURRENCY=

# Allow an event with an unstated date to use the Tehran date of the source
# message instead of asking. Owner decision; default is to ask.
ALLOW_MESSAGE_DATE_AS_EVENT_DATE=false

# AI-written narrative on top of the deterministic report. Falls back to the
# deterministic template when the AI is unavailable or its text is unsafe.
REPORT_NARRATIVE_ENABLED=true

# How many past Tehran days the worker may catch up on missed daily reports.
REPORT_CATCHUP_DAYS=1

# ---------------------------------------------------------------------------
# Persistence and runtime (paths are examples; use real cPanel paths)
# ---------------------------------------------------------------------------
# REQUIRED. Absolute path OUTSIDE public_html.
DATABASE_PATH=/home/CPANEL_USER/data/kalampeach_bot.sqlite3

# Optional. JSON log line destination. Empty = stderr (cPanel error log).
LOG_FILE=
LOG_LEVEL=INFO

# Optional: private env file read by cron invocations that do not inherit the
# cPanel application environment. Existing process variables win.
# KALAMPEACH_ENV_FILE is the preferred name; ENV_FILE is accepted as an alias.
# KALAMPEACH_ENV_FILE=/home/CPANEL_USER/private/kalampeach.env
# ENV_FILE=/home/CPANEL_USER/private/kalampeach.env

# Worker tuning (safe defaults for shared hosting).
WORKER_MAX_RUNTIME_SECONDS=50
WORKER_BATCH_SIZE=20
INBOX_MAX_ATTEMPTS=5
REPORT_MAX_ATTEMPTS=5
MAX_CLARIFICATION_ROUNDS=3
MAX_REPORT_RANGE_DAYS=31
