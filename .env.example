# Copy values into the private environment configured in cPanel.
# Never commit real values or place this file under public_html.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
MANAGER_TELEGRAM_ID=
# Comma-separated numeric Telegram user IDs allowed to record events.
EMPLOYEE_TELEGRAM_IDS=
# Random high-entropy secret used to validate Telegram webhook requests.
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS URL including the webhook path, e.g. https://example.com/telegram/webhook
WEBHOOK_PUBLIC_URL=

# NVIDIA API — provide verified values for the selected NVIDIA service/model.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=

# Business configuration
BUSINESS_TIMEZONE=Asia/Tehran
DAILY_REPORT_TIME=23:30
# Leave empty until the owner explicitly chooses a default currency.
DEFAULT_CURRENCY=

# Persistence — absolute path outside public_html.
DATABASE_PATH=/home/CPANEL_USER/data/kalampeach_bot.sqlite3

# Runtime
LOG_LEVEL=INFO
